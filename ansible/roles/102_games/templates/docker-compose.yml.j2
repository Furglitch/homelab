---
x-common-config: &default-service
    labels:
        - "deunhealth.restart.on.unhealthy=true"
    environment: &default-environment
        PUID: "{{ puid }}"
        PGID: "{{ pgid }}"
        UMASK: "{{ umask }}"
        TZ: "{{ timezone }}"
    restart: unless-stopped

services:

    calagopus-panel:
        <<: [*default-service]
        image: ghcr.io/calagopus/panel:heavy-aio
        container_name: calagopus-panel
        depends_on:
            calagopus-db:
                condition: service_healthy
                restart: true
            calagopus-cache:
                condition: service_started
        environment:
            REDIS_URL: redis://calagopus-cache
            DATABASE_URL: {{ ('postgresql://' ~ (credentials.db.user | trim | urlencode) ~ ':' ~ (credentials.db.pass | trim | urlencode) ~ '@calagopus-db:5432/calagopus-db') | to_json }}
            DATABASE_MIGRATE: "true"
            AIO_BASE_WINGS_CONFIGURATION: /config.yml
            APP_LOG_DIRECTORY: /var/log/calagopus
            APP_ENABLE_WINGS_PROXY: "true"
            APP_ENCRYPTION_KEY: "{{ tokens.calagopus.encryption }}"
        volumes:
            - {{ files.docker.sock }}:{{ files.docker.sock }}
            # -- Panel -- #
            - {{ files.docker.data }}/calagopus/panel/data:/var/lib/calagopus
            - {{ files.docker.data }}/calagopus/panel/logs:/var/log/calagopus
            # -- Wings -- #
            - {{ files.docker.data }}/calagopus/wings/data:/var/lib/calagopus-wings
            - {{ files.docker.data }}/calagopus/wings/logs:/var/log/calagopus-wings
            - {{ files.docker.data }}/calagopus/wings/containers:/var/lib/docker/containers
            - {{ files.docker.data }}/calagopus/wings/etc:/etc/calagopus-wings
            - {{ files.docker.config }}/calagopus/wings/config.yml:/config.yml
            - /tmp/calagopus-wings:/tmp/calagopus-wings
            # -- Heavy -- #
            - {{ files.docker.data }}/calagopus/heavy/binaries:/app/binaries
            - {{ files.docker.data }}/calagopus/heavy/translations:/app/translations
            - {{ files.docker.data }}/calagopus/heavy/extensions:/app/extensions
            - {{ files.docker.data }}/calagopus/heavy/extension-migrations:/app/repo/database/extension-migrations
        ports:
            - {{ ports.calagopus.http }}:8000
            - {{ ports.calagopus.sftp }}:2022

    calagopus-db:
        <<: [*default-service]
        image: ghcr.io/calagopus/pgautoupgrade:18-alpine
        container_name: calagopus-db
        environment: 
            POSTGRES_DB: calagopus-db
            POSTGRES_USER: {{ credentials.db.user | trim | to_json }}
            POSTGRES_PASSWORD: {{ credentials.db.pass | trim | to_json }}
            PGDATA: /data
        volumes: 
            - {{ files.docker.data }}/calagopus/db:/data
        healthcheck:
            test: ["CMD", "/usr/local/bin/pgautoupgrade-healthcheck.sh"]
            interval: 10s
            timeout: 5s
            retries: 5
            start_period: 30s

    calagopus-cache:
        <<: [*default-service]
        image: ghcr.io/calagopus/valkey:latest
        container_name: calagopus-cache
        command: --protected-mode no --save 60 1
        volumes:
            - calagopus-cache:/data

    romm:
        <<: [*default-service]
        image: rommapp/romm:latest
        container_name: romm
        depends_on:
            romm-db:
                condition: service_healthy
                restart: true
        environment: 
            DB_HOST: romm-db
            DB_NAME: romm
            DB_USER: {{ credentials.db.user | trim | to_json }}
            DB_PASSWD: {{ credentials.db.pass | trim | to_json }}
            ROMM_BASE_URL: https://romm.{{ domain.gaming }}
            ROMM_SESSION_SECURE_COOKIE: true
            ROMM_CORS_ALLOWED_ORIGINS: https://romm.{{ domain.gaming }}
            SCREENSCRAPER_USER: {{ tokens.romm.screenscraper.user }}
            SCREENSCRAPER_PASSWORD: {{ tokens.romm.screenscraper.pass }}
            RETROACHIEVEMENTS_API_KEY: {{ tokens.romm.retroachievements }}
            STEAMGRIDDB_API_KEY: {{ tokens.romm.steamgriddb }}
        volumes: 
            - {{ files.docker.config }}/romm/config:/romm/config
            - {{ files.nfs.media }}/games:/romm/library
            - romm-assets:/romm/assets
            - romm-resources:/romm/resources
        ports:
            - {{ ports.romm }}:8080

    romm-db:
        <<: [*default-service]
        image: mariadb:latest
        container_name: romm-db
        environment: 
            MARIADB_DATABASE: romm
            MARIADB_USER: {{ credentials.db.user | trim | to_json }}
            MARIADB_PASSWORD: {{ credentials.db.pass | trim | to_json }}
            MARIADB_ROOT_PASSWORD: {{ credentials.db.pass | trim | to_json }}
        volumes: 
            - {{ files.docker.data }}/romm/db:/var/lib/mysql
        healthcheck:
            test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
            interval: 10s
            timeout: 5s
            retries: 5
            start_period: 30s

volumes:
    romm-assets:
    romm-resources:
    calagopus-cache:
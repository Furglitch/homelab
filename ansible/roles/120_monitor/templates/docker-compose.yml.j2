---
x-common-config: &default-service
    labels:
        - "deunhealth.restart.on.unhealthy=true"
    user: "{{ puid }}:{{ pgid }}"
    environment: &default-environment
        PUID: "{{ puid }}"
        PGID: "{{ pgid }}"
        UMASK: "{{ umask }}"
        TZ: "{{ timezone }}"
    restart: unless-stopped

services:

    glance:
        <<: [*default-service]
        image: glanceapp/glance:latest
        container_name: glance
        environment:
            PLEX_URL: http://{{ ip.media }}:32400
            PLEX_TOKEN: {{ credentials.plex }}
            SEERR_URL: http://{{ ip.media }}:32402
            SEERR_TOKEN: {{ credentials.seerr }}
            RADARR_URL: http://{{ ip.media }}:32601
            RADARR_TOKEN: {{ credentials.radarr }}
            SONARR_URL: http://{{ ip.media }}:32602
            SONARR_TOKEN: {{ credentials.sonarr }}
        volumes: 
            - {{ files.docker.config }}/glance:/app/config
            - {{ files.docker.sock }}:{{ files.docker.sock }}:ro
        ports:
            - {{ ports.glance }}:8080
    
    whatsupdocker:
        <<: [*default-service]
        image: getwud/wud:latest
        container_name: whatsupdocker
        user: "0:0"
        environment:
            - WUD_AUTH_ADMIN_USER=admin
            - WUD_AUTH_ADMIN_PASSWORD={{ tokens.wud.pass }}
        volumes: 
            - wud-data:/store
            - {{ files.docker.sock }}:{{ files.docker.sock }}
        ports:
            - {{ ports.whatsupdocker }}:3000

    dozzle:
        <<: [*default-service]
        image: amir20/dozzle:latest
        container_name: dozzle
        user: "0:0"
        # environment:
        #     DOZZLE_REMOTE_AGENT:
        volumes: 
            - dozzle-data:/data
            - {{ files.docker.sock }}:{{ files.docker.sock }}
        ports:
            - {{ ports.dozzle }}:8080

    homelable:
        <<: [*default-service]
        image: ghcr.io/pouzor/homelable-frontend:latest
        container_name: homelable
        user: "0:0"
        depends_on: [backend]
        ports:
            - {{ ports.homelable }}:80
        networks:
            - homelable

    backend:
        <<: [*default-service]
        image: ghcr.io/pouzor/homelable-backend:latest
        container_name: homelable-backend
        user: "0:0"
        environment:
            AUTH_MODE: 'local'
            AUTH_USERNAME: {{ tokens.homelable.user }}
            AUTH_PASSWORD_HASH: {{ tokens.homelable.pass }}
            SQLITE_PATH: /app/data/homelab.db
            SECRET_KEY: {{ credentials.db.pass }}
            # CORS_ORIGINS: '["http://localhost:{{ ports.homelable }}","http://{{ local_ip }}:{{ ports.homelable }}"]'
        volumes:
            - homelable-backend:/app/data
        networks:
            - homelable
        cap_add:
            - NET_RAW
        # healthcheck:
        #     test: ["CMD", "curl", "-f", "http://localhost:8000/api/v1/health"]
        #     interval: 10s
        #     timeout: 5s
        #     retries: 6
        #     start_period: 15s

    apprise:
        <<: [*default-service]
        image: caronc/apprise:latest
        container_name: apprise
        user: "0:0"
        environment:
            APPRISE_STATEFUL_MODE: simple
            APPRISE_WORKER_COUNT: 1
            APPRISE_DEFAULT_FORMAT: "markdown"
            APPRISE_AUTH_REQUIRES: "yes"
            APPRISE_USER: admin
            APPRISE_PASSWORD: {{ tokens.apprise.pass }}
            APPRISE_WEB_AUTH_SECRET: {{ tokens.apprise.secret }}
        volumes:
            - {{ files.docker.config }}/apprise:/config
            - {{ files.docker.config }}/apprise/attach:/attach
        ports:
            - {{ ports.apprise }}:8000

volumes:
    wud-data:
    dozzle-data:
    homelable-backend:

networks:
  homelable:
    driver: bridge
---
x-common-config: &default-service
    environment: &default-environment
        PUID: "{{ puid }}"
        PGID: "{{ pgid }}"
        UMASK: "{{ umask }}"
        TZ: "{{ time }}"
    restart: unless-stopped

services:
    calagopus:
        <<: [*default-service]
        image: ghcr.io/calagopus/panel:heavy-aio
        container_name: calagopus-panel
        depends_on:
            - db
            - cache
        ports:
            - {{ ports.calagopus.main }}:8000
            - {{ ports.calagopus.sftp }}:2022
        volumes:
            - {{ files.docker_data_path }}/calagopus/panel/data:/var/lib/calagopus
            - {{ files.docker_data_path }}/calagopus/panel/logs:/var/log/calagopus
            - {{ files.docker_config_path }}/calagopus/wings/wings-config.yml:/wings-config.yml
            - {{ files.docker_sock }}:/var/run/docker.sock
            - {{ files.docker_data_path }}/calagopus/wings/data:/var/lib/calagopus-wings
            - {{ files.docker_data_path }}/calagopus/wings/logs:/var/log/calagopus-wings
            - {{ files.docker_data_path }}/calagopus/wings/containers:/var/lib/docker/containers
            - {{ files.docker_data_path }}/calagopus/wings/etc:/etc/calagopus-wings
            - /tmp/calagopus-wings:/tmp/calagopus-wings
            - {{ files.docker_data_path }}/calagopus/heavy/binaries:/app/binaries
            - {{ files.docker_data_path }}/calagopus/heavy/translations:/app/translations
            - {{ files.docker_data_path }}/calagopus/heavy/extensions:/app/extensions
            - {{ files.docker_data_path }}/calagopus/heavy/extension-migrations:/app/repo/database/extension-migrations
        environment: 
            <<: *default-environment
            REDIS_URL: redis://cache
            DATABASE_URL: postgresql://panel:panel@db/panel
            DATABASE_MIGRATE: "true"
            PORT: "8000"
            AIO_BASE_WINGS_CONFIGURATION: /wings-config.yml
            APP_DEBUG: "false"
            APP_LOG_DIRECTORY: /var/log/calagopus
            APP_PRIMARY: "true"
            APP_ENABLE_WINGS_PROXY: "true"
            APP_ENCRYPTION_KEY: "{{ tokens.calagopus.encryption }}"
            APP_USE_DECRYPTION_CACHE: "true"
            APP_USE_INTERNAL_CACHE: "true"
        dns:
            - 1.1.1.1
            - 8.8.8.8
            - 9.9.9.9
        # extra_hosts:
        #     - "host.docker.internal:host-gateway"

    db:
        <<: [*default-service]
        image: ghcr.io/calagopus/pgautoupgrade:18-alpine
        container_name: calagopus-db
        environment:
            POSTGRES_USER: panel
            POSTGRES_PASSWORD: panel
            POSTGRES_DB: panel
            PGDATA: /data
        volumes:
            - {{ files.docker_data_path }}/calagopus/db:/data


    cache:
        <<: [*default-service]
        image: ghcr.io/calagopus/valkey:latest
        container_name: calagopus-cache
        command: --protected-mode no --save 60 1
        volumes:
            - cache:/data

volumes:
    cache:
        name: calagopus-cache
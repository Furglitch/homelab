---
x-common-config: &default-service
  labels:
    - "deunhealth.restart.on.unhealthy=true"
  environment:
    - PUID={{ puid }}
    - PGID={{ pgid }}
    - UMASK={{ umask }}
    - TZ={{ time }}
  restart: unless-stopped

services:
  homarr:
    <<: *default-service
    image: "ghcr.io/homarr-labs/homarr:latest"
    container_name: homarr
    environment:
      - SECRET_ENCRYPTION_KEY={{ homarr.secret_encryption_key }}
      - REDIS_IS_EXTERNAL=false
    volumes:
      - {{ files.docker_sock }}:/var/run/docker.sock
      - {{ files.docker_config_path }}/homarr:/appdata
    ports:
      - {{ ports.homarr }}:7575
    restart: always

  vaultwarden:
    <<: *default-service
    image: "vaultwarden/server:latest"
    container_name: vaultwarden
    volumes:
      - {{ files.docker_config_path }}/vaultwarden:/config
      - {{ files.docker_data_path }}/vaultwarden:/data
    ports:
      - {{ ports.vaultwarden }}:80
    restart: always

  nextcloud:
    <<: *default-service
    image: "lscr.io/linuxserver/nextcloud:latest"
    container_name: nextcloud
    environment:
      - VIRTUAL_HOST=https://{{ ip_public }}
      - LETSENCRYPT_HOST=https://{{ ip_public }}
    ports:
      - {{ ports.nextcloud }}:443
    volumes:
      - {{ files.docker_config_path }}/nextcloud:/config
      - {{ files.docker_data_path }}/nextcloud:/data
      - {{ files.nfs_cloud_path }}:/share
    restart: always

  sillytavern:
    <<: *default-service
    image: "ghcr.io/sillytavern/sillytavern:latest"
    container_name: sillytavern
    environment:
      - NODE_ENV=production
      - FORCE_COLOR=1
      - PUBLIC_PORT={{ ports.sillytavern }}
    ports:
      - {{ ports.sillytavern }}:{{ ports.sillytavern }}
    volumes:
      - {{ files.docker_config_path }}/sillytavern/config:/home/node/app/config
      - {{ files.docker_config_path }}/sillytavern/data:/home/node/app/data
      - {{ files.docker_config_path }}/sillytavern/plugins:/home/node/app/plugins
      - {{ files.docker_config_path }}/sillytavern/extensions:/home/node/app/extensions
    restart: always

  protonmail-bridge:
    <<: *default-service
    image: "ghcr.io/dancwilliams/protonmail-bridge-docker:latest"
    container_name: protonmail
    ports:
      - {{ ports.proton_imap }}:143
      - {{ ports.proton_smtp }}:25
    volumes:
      - protonmail:/root

  pokecollector-db:
    image: postgres:18-alpine
    container_name: pkmn-db
    restart: unless-stopped
    environment:
      POSTGRES_USER: pokemon
      POSTGRES_PASSWORD: {{ pokecollector.postgres.password }}
      POSTGRES_DB: pokemon_tcg
    volumes:
      - pokecollector-db:/var/lib/postgresql
    command:
      - sh
      - -c
      - |
        for legacy_pg_version_file in /var/lib/postgresql/PG_VERSION /var/lib/postgresql/data/PG_VERSION; do
          if [ -s "$${legacy_pg_version_file}" ]; then
            legacy_pg_version="$$(cat "$${legacy_pg_version_file}")"
            if [ "$${legacy_pg_version}" != "18" ]; then
              echo >&2 "ERROR: Found PostgreSQL $${legacy_pg_version} data in the pokecollector-db volume."
              echo >&2 "Run ./scripts/upgrade-postgres-15-to-18.sh before starting PostgreSQL 18."
              echo >&2 "Do not delete the volume; it is needed for the upgrade/rollback path."
              exit 1
            fi
          fi
        done
        exec docker-entrypoint.sh postgres
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U pokemon -d pokemon_tcg"]
      interval: 10s
      timeout: 5s
      retries: 5

  pokecollector-backend:
    build:
      context: https://github.com/Git-Romer/pokecollector.git#main
      dockerfile: backend/Dockerfile
    image: pokecollector-backend:latest
    container_name: pkmn-backend
    restart: unless-stopped
    environment:
      DATABASE_URL: postgresql://pokemon:{{ pokecollector.postgres.password }}@pokecollector-db:5432/pokemon_tcg
      TELEGRAM_BOT_TOKEN: {{ pokecollector.telegram.bot_token}}
      TELEGRAM_CHAT_ID: {{ pokecollector.telegram.chat_id }}
      ADMIN_USERNAME: {{ pokecollector.admin.username }}
      ADMIN_PASSWORD: {{ pokecollector.admin.password }}
      USER_MODE: {{ pokecollector.user_mode }}
      JWT_SECRET_KEY: {{ pokecollector.jwt.secret_key }}
      GEMINI_API_KEY: {{ pokecollector.gemini.api_key }}
      GEMINI_MODEL: {{ pokecollector.gemini.model }}
      GEMINI_ALLOWED_MODELS: {{ pokecollector.gemini.allowed_models }}
      OPENAI_SCANNER_ENABLED: {{ pokecollector.openai.scanner_enabled }}
      OPENAI_PROVIDER_LABEL: {{ pokecollector.openai.provider_label }}
      OPENAI_BASE_URL: {{ pokecollector.openai.base_url }}
      OPENAI_MODEL: {{ pokecollector.openai.model }}
      OPENAI_ALLOWED_MODELS: {{ pokecollector.openai.allowed_models }}
      OPENAI_API_KEY_REQUIRED: {{ pokecollector.openai.api_key_required }}
      TCGDEX_SYNC_LANGUAGES: {{ pokecollector.tcgdex.sync_languages }}
      CORS_ORIGINS: {{ pokecollector.cors_origins }}
      PRE_UPGRADE_BACKUP_ENABLED: {{ pokecollector.pre_upgrade.backup.enabled }}
      PRE_UPGRADE_BACKUP_REQUIRED: {{ pokecollector.pre_upgrade.backup.required }}
      PRE_UPGRADE_BACKUP_KEEP: {{ pokecollector.pre_upgrade.backup.keep }}
      POKEDEX_IMAGE_CACHE_DIR: /app/data/pokedex-images
      SCAN_UPLOAD_DIR: /app/data/scan-uploads
      SCAN_TRACE_DIR: ""
      SCAN_TRACE_STORAGE_DIR: /app/data/scan-traces
    depends_on:
      pokecollector-db:
        condition: service_healthy
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - {{ files.docker_config_path }}/pokecollector/data/backups:/app/backups
      - {{ files.docker_config_path }}/pokecollector/data/auth:/app/data/auth
      - pokecollector-pokedex-images:/app/data/pokedex-images
      - pokecollector-scan_traces:/app/data/scan-traces
      - pokecollector-scan_uploads:/app/data/scan-uploads
    ports:
      - {{ports.pokecollector_backend}}:8000
    networks:
      default:
        aliases:
          - backend

  pokecollector-frontend:
    build:
      context: https://github.com/Git-Romer/pokecollector.git#main
      dockerfile: frontend/Dockerfile
      args:
        PUBLIC_MODE: {{ pokecollector.public_mode }}
    image: pokecollector-frontend:latest
    container_name: pkmn-frontend
    restart: unless-stopped
    depends_on:
      - pokecollector-backend
    ports:
      - {{ports.pokecollector}}:80

volumes:
  protonmail:
    name: protonmail
  pokecollector-db:
    name: pokecollector-db
  pokecollector-pokedex-images:
    name: pokecollector-pokedex-images
  pokecollector-scan_traces:
    name: pokecollector-scan_traces
  pokecollector-scan_uploads:
    name: pokecollector-scan_uploads